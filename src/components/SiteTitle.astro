---
// The OhrTech wordmark (inverse: the header is charcoal in both themes) and "Developers".
import { logos } from 'virtual:starlight/user-images';
const { siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title">
	<img alt="OhrTech" src={logos.dark?.src} width={logos.dark?.width} height={logos.dark?.height} />
	<span class="divider" aria-hidden="true"></span>
	<span class="label" translate="no">Developers</span>
</a>

<style>
	.site-title {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		text-decoration: none;
		white-space: nowrap;
		min-width: 0;
	}
	img {
		height: 34px;
		width: auto;
	}
	.divider {
		width: 1px;
		height: 22px;
		background: rgba(255, 255, 255, 0.22);
	}
	.label {
		font-family: var(--sl-font-mono);
		font-size: 0.8rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--ohr-on-dark-soft);
	}
	@media (max-width: 30rem) {
		.divider,
		.label {
			display: none;
		}
	}
</style>
