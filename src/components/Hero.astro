---
// The home page's opening band: the dark charcoal-to-navy panel with the faint engineering grid
// from ohrtech.net, the pitch on the left and real code on the right.
import { Code } from 'astro:components';
import { LinkButton } from '@astrojs/starlight/components';

const { data } = Astro.locals.starlightRoute.entry;
const { title = data.title, tagline, actions = [] } = data.hero || {};

const sample = `using OhrTech.Management;

using var api = OhrManagementClient.ForServiceAccount(token);

// Every device in your fleets, live
foreach (var d in await api.ListDevicesAsync(online: true))
    Console.WriteLine($"{d.Serial}  {d.BatteryLevel}%");

// Its screen, inside your own help desk
var rc = await api.OpenRemoteControlSessionAsync(42, new()
{
    EmbedOrigins = ["https://support.example.com"]
});
// <iframe src={rc.Embed.Url}>`;
---

<div class="ohr-hero not-content">
	<div class="copy">
		<p class="ohr-eyebrow">The OhrTech SDK</p>
		<h1 id="_top" data-page-title set:html={title} />
		{tagline && <p class="tagline" set:html={tagline} />}
		{
			actions.length > 0 && (
				<div class="actions">
					{actions.map(({ link: href, text, variant, icon }) => (
						<LinkButton {href} {variant} icon={icon?.name}>
							{text}
						</LinkButton>
					))}
				</div>
			)
		}
	</div>
	<figure class="sample">
		<figcaption>Program.cs</figcaption>
		<Code code={sample} lang="csharp" theme="github-dark-default" />
	</figure>
</div>

<style>
	.ohr-hero {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: grid;
		grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
		gap: clamp(1.5rem, 4vw, 3rem);
		align-items: center;
		padding: clamp(2rem, 5vw, 3.5rem);
		border-radius: var(--ohr-radius);
		color: var(--ohr-on-dark);
		background:
			radial-gradient(1200px 500px at 85% 120%, rgba(248, 128, 36, 0.16), transparent 60%),
			linear-gradient(135deg, var(--ohr-charcoal) 0%, #142347 58%, var(--ohr-navy) 100%);
	}
	/* Faint engineering grid, as on ohrtech.net */
	.ohr-hero::before {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		background-image:
			linear-gradient(rgba(255, 255, 255, 0.045) 1px, transparent 1px),
			linear-gradient(90deg, rgba(255, 255, 255, 0.045) 1px, transparent 1px);
		background-size: 48px 48px;
		mask-image: linear-gradient(180deg, transparent, #000 30%, #000 70%, transparent);
	}
	.copy {
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}
	.ohr-eyebrow {
		color: var(--ohr-flame);
	}
	h1 {
		margin: 0;
		color: #ffffff;
		font-size: clamp(2.1rem, 4.2vw, 3.2rem);
		font-weight: 700;
		line-height: 1.1;
		letter-spacing: -0.015em;
		text-wrap: balance;
	}
	.tagline {
		margin: 0;
		color: var(--ohr-on-dark-soft);
		font-size: clamp(1.0625rem, 1.6vw, 1.2rem);
		line-height: 1.55;
		max-width: 34rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 0.5rem;
	}
	.actions :global(.sl-link-button) {
		min-height: 48px;
		padding: 0 1.4rem;
		border-radius: var(--ohr-radius-sm);
		border-width: 2px;
		font-size: 1rem;
	}
	.actions :global(.sl-link-button.secondary) {
		color: #ffffff;
		border-color: rgba(255, 255, 255, 0.85);
		background: transparent;
	}
	.actions :global(.sl-link-button.secondary:hover) {
		background: rgba(255, 255, 255, 0.08);
	}
	.sample {
		min-width: 0;
		margin: 0;
		overflow: hidden;
		border: 1px solid var(--ohr-line-dark);
		border-radius: var(--ohr-radius-sm);
		background: #0d1117;
		box-shadow: 0 18px 48px rgba(0, 0, 0, 0.35);
	}
	figcaption {
		padding: 0.55rem 1rem;
		border-bottom: 1px solid var(--ohr-line-dark);
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		color: var(--ohr-on-dark-soft);
		background: #161b22;
	}
	.sample :global(pre) {
		margin: 0;
		padding: 1rem 1.1rem;
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		line-height: 1.6;
		font-variant-ligatures: none;
		overflow-x: auto;
	}
	@media (max-width: 60rem) {
		.ohr-hero {
			grid-template-columns: minmax(0, 1fr);
		}
	}
</style>
